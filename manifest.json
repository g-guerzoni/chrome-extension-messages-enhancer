{
  "manifest_version": 3,
  "name": "AI Message Enhancer",
  "description": "Enhance, correct typos, fix grammar, and beautify your text for Slack, Teams, email, and any website using AI",
  "version": "3.0.0",
  "permissions": ["storage", "contextMenus"],
  "action": {
    "default_popup": "src/interface/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/interface/options.html",
  "background": {
    "service_worker": "src/scripts/background.js",
    "type": "module"
  },
  "commands": {
    "enhance-field": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Enhance the focused text field (or the selected text)"
    }
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["src/scripts/content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ]
}
