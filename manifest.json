{
  "manifest_version": 3,
  "name": "AI Message Enhancer",
  "description": "Fix typos, grammar and tone in any text field with AI. Uses your own OpenRouter or OpenAI API key.",
  "version": "3.0.0",
  "permissions": ["storage", "contextMenus", "scripting", "activeTab"],
  "action": {
    "default_popup": "src/interface/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "options_page": "src/interface/options.html",
  "background": {
    "service_worker": "src/scripts/background.js",
    "type": "module"
  },
  "commands": {
    "enhance-field": {
      "suggested_key": {
        "default": "Alt+Shift+E"
      },
      "description": "Enhance the focused text field (or the selected text)"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/scripts/content.js"],
      "all_frames": true,
      "match_about_blank": true,
      "match_origin_as_fallback": true,
      "run_at": "document_idle"
    }
  ]
}
